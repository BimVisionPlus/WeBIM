# Bắt buộc: domain đã trỏ DNS A/AAAA về máy chủ này.
WEBIM_DOMAIN=webim.example.vn

# Bắt buộc khi bật auth: secret ký token (openssl rand -hex 32).
WEBIM_SECRET=

# Tuỳ chọn: bật AI đọc bản vẽ.
ANTHROPIC_API_KEY=

# Tuỳ chọn: BYO storage S3-compatible (bỏ trống = lưu local trong volume).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-southeast-1
