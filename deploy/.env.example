# Bắt buộc: domain đã trỏ DNS A/AAAA về máy chủ này.
WEBIM_DOMAIN=webim.vn

# Tuỳ chọn: Atlas chạy cùng máy (xem atlas-override.yml). Trỏ A record của
# tên này về cùng IP, nếu không Caddy sẽ xin chứng chỉ mãi không xong.
ATLAS_DOMAIN=atlas.webim.vn

# Bắt buộc khi bật auth: secret ký token (openssl rand -hex 32).
WEBIM_SECRET=

# Tuỳ chọn: AI tự host — không dùng API đóng nào.
# Model server tương thích OpenAI (Ollama/vLLM/llama.cpp). Bỏ trống = tắt AI.
AI_BASE_URL=
AI_MODEL=qwen2.5vl:7b
AI_API_KEY=
# Stable Diffusion tự host (A1111/SD.Next/Forge). Bỏ trống = chỉ có brief chữ.
SD_BASE_URL=

# Tuỳ chọn: BYO storage S3-compatible (bỏ trống = lưu local trong volume).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-southeast-1
