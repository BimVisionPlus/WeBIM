# WeBIM production entry point — automatic HTTPS via Let's Encrypt.
# Set WEBIM_DOMAIN (and an email for ACME) in deploy/.env.

{$WEBIM_DOMAIN} {
	encode zstd gzip

	# Platform server: files + auth + AI + WebSocket sync relay.
	# handle_path strips /api before proxying, and Caddy upgrades
	# WebSocket connections automatically.
	#
	# Two blocks, because handle_path takes exactly one matcher and `/api/*`
	# requires a segment after the slash: it matches /api/health but NOT the
	# bare /api the sync client opens its socket on. That fell through to the
	# SPA handler and got index.html back, which a WebSocket upgrade cannot
	# use — so the app reported "chế độ độc lập" on a server running fine.
	handle_path /api/* {
		reverse_proxy relay:8787
	}
	handle_path /api {
		reverse_proxy relay:8787
	}

	# Static SPA build.
	handle {
		root * /srv/webim
		try_files {path} /index.html
		file_server
	}
}

# Atlas AEC on the same box — see atlas-override.yml. `atlas-web` is the
# alias the Atlas compose project publishes on the shared webim_edge
# network; this vhost 502s until that project is up, which is the honest
# failure for "Atlas isn't running yet".
#
# Point atlas.webim.vn's A record at this server too, or Caddy will keep
# retrying ACME for a name that does not resolve.
{$ATLAS_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Uploads are IFC/RVT models, not form posts.
	request_body {
		max_size 2GB
	}

	reverse_proxy atlas-web:3000 {
		header_up X-Forwarded-Proto {scheme}
	}
}
