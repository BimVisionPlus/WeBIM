// ============================================================================
//  Atlas AEC — Prisma schema
//  Atlassian suite clone re-skinned for Architecture / Engineering / Construction
//  VN-grounded: NĐ 06/2021/NĐ-CP (chất lượng + nghiệm thu), NĐ 15/2021,
//  Luật Xây dựng 50/2014 sđ 62/2020, NĐ 10/2021 (chi phí).
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenancy & Identity ─────────────────────────────────────────────────────

model Organization {
  id             String   @id @default(cuid())
  name           String // "CTCP Xây dựng Cofico"
  slug           String   @unique // "cofico"
  mst            String? // Mã số thuế
  type           OrgType // CĐT / TVGS / NT_CHINH / NT_PHU / TV_THIET_KE
  address        String?
  phone          String?
  email          String?
  isBetaApproved Boolean  @default(false) // gates onboarding for waitlist pilot
  createdAt      DateTime @default(now())

  members       Membership[]
  projectsOwned Project[]            @relation("OwnerOrg")
  projectRoles  ProjectStakeholder[]
  invites       Invite[]
  auditEvents   AuditEvent[]
  bids          Bid[]
  paymentApps   PaymentApplication[] @relation("PaymentContractor")
}

enum OrgType {
  CHU_DAU_TU // Chủ đầu tư (Owner / Client)
  TU_VAN_GIAM_SAT // Tư vấn giám sát (Supervision consultant)
  TU_VAN_THIET_KE // Tư vấn thiết kế (Design consultant)
  NHA_THAU_CHINH // Nhà thầu chính (Main contractor)
  NHA_THAU_PHU // Nhà thầu phụ (Sub-contractor)
  NHA_CUNG_CAP // Nhà cung cấp (Supplier)
  CO_QUAN_NHA_NUOC // Cơ quan nhà nước (e.g. Sở Xây dựng, PC07)
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String
  phone         String?
  passwordHash  String?
  caCertSerial  String? // VNPT-CA / Viettel-CA cert serial for chữ ký số
  avatarUrl     String?
  isSuperAdmin  Boolean   @default(false) // platform-level admin (Atlas team)
  lockedUntil   DateTime? // brute-force lockout window
  failedLogins  Int       @default(0)
  createdAt     DateTime  @default(now())

  memberships    Membership[]
  assignedIssues Issue[]              @relation("Assignee")
  reportedIssues Issue[]              @relation("Reporter")
  signoffs       Signoff[]
  dailyLogs      DailyLog[]
  comments       Comment[]
  sessions       Session[]
  accounts       Account[]
  auditEvents    AuditEvent[]
  invitesSent    Invite[]             @relation("InvitedBy")
  resetTokens    PasswordResetToken[]
  bidsOwned      Bid[]                @relation("BidOwner")
}

// ─── NextAuth ────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ip           String?
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Membership {
  id     String     @id @default(cuid())
  userId String
  orgId  String
  role   MemberRole

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

enum MemberRole {
  OWNER // Lãnh đạo tổ chức
  ADMIN
  PROJECT_MGR // Chỉ huy trưởng
  ENGINEER // Kỹ sư
  SUPERVISOR // Giám sát
  FIELD // Công nhân hiện trường (mobile-only)
  VIEWER // CĐT view-only
}

// ─── Project (the top-level container) ──────────────────────────────────────

model Project {
  id               String        @id @default(cuid())
  key              String        @unique // "VINHOMES-Q9" — used as prefix: VINHOMES-Q9-RFI-001
  name             String // "Vinhomes Grand Park — Lô S9"
  ownerOrgId       String
  address          String?
  province         String? // "TP. HCM"
  district         String?
  contractValueVnd BigInt? // Giá trị hợp đồng (VND)
  startDate        DateTime?
  endDate          DateTime?
  status           ProjectStatus @default(PLANNING)
  permitNumber     String? // Số giấy phép xây dựng
  permitDate       DateTime?
  warrantyMonths   Int           @default(24) // NĐ 06/2021: 12 tháng phần phụ, 24 tháng phần chính, 60 tháng hạ tầng
  createdAt        DateTime      @default(now())

  ownerOrg           Organization         @relation("OwnerOrg", fields: [ownerOrgId], references: [id])
  stakeholders       ProjectStakeholder[]
  issues             Issue[]
  rfis               RFI[]
  submittals         Submittal[]
  ncrs               NCR[]
  punchItems         PunchItem[]
  changeOrders       ChangeOrder[]
  dailyLogs          DailyLog[]
  drawingSets        DrawingSet[]
  models             Model[]
  acceptances        Acceptance[]
  payments           ProgressPayment[]
  specs              SpecPage[]
  bids               Bid[]
  regulations        ProjectRegulation[]
  boqs               BoQ[]
  overrunSignals     CostOverrunSignal[]
  scheduleTasks      ScheduleTask[]
  permitApplications PermitApplication[]
  pcccApplications   PcccApplication[]
  paymentApps        PaymentApplication[]
  takeoffSheets      TakeoffSheet[]
}

enum ProjectStatus {
  PLANNING // Chuẩn bị
  IN_PROGRESS // Đang thi công
  HANDOVER // Bàn giao
  WARRANTY // Bảo hành
  CLOSED // Đã đóng hồ sơ
}

model ProjectStakeholder {
  id        String  @id @default(cuid())
  projectId String
  orgId     String
  role      OrgType // role this org plays on THIS project

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  org     Organization @relation(fields: [orgId], references: [id])

  @@unique([projectId, orgId, role])
}

// ============================================================================
//  SITE module — Atlassian "Jira" reskinned
//  Unified issue type with discriminator. Each subtype carries its own
//  workflow + extension table.
// ============================================================================

model Issue {
  id           String    @id @default(cuid())
  key          String    @unique // "VINHOMES-Q9-123"
  projectId    String
  type         IssueType
  title        String
  description  String?   @db.Text
  state        String // FSM state, validated by packages/workflows
  priority     Priority  @default(MEDIUM)
  reporterId   String
  assigneeId   String?
  dueDate      DateTime?
  locationZone String? // "Tầng 12 — Khu B"
  sheetId      String? // pinned to a drawing sheet?
  positionX    Float? // X-coord on sheet (0-1)
  positionY    Float? // Y-coord on sheet (0-1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  closedAt     DateTime?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter    User         @relation("Reporter", fields: [reporterId], references: [id])
  assignee    User?        @relation("Assignee", fields: [assigneeId], references: [id])
  sheet       Sheet?       @relation(fields: [sheetId], references: [id])
  comments    Comment[]
  attachments Attachment[]
  transitions Transition[]

  rfi          RFI?
  submittal    Submittal?
  ncr          NCR?
  punchItem    PunchItem?
  changeOrder  ChangeOrder?
  elementLinks IssueElementLink[]

  @@index([projectId, type, state])
  @@index([assigneeId, state])
}

enum IssueType {
  TASK // Generic task
  RFI // Request for Information
  SUBMITTAL // Vật liệu / shop drawing submittal
  NCR // Non-Conformance Report — sai khác chất lượng
  PUNCH // Punch list item — danh mục lỗi tồn đọng
  CHANGE_ORDER // Lệnh thay đổi
  SAFETY // Sự cố ATLĐ
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL // Blocking, e.g. NCR-major or RFI on critical path
}

model Transition {
  id        String   @id @default(cuid())
  issueId   String
  fromState String
  toState   String
  byUserId  String
  reason    String?
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])
}

// ─── RFI (Request for Information) ──────────────────────────────────────────
//  States: DRAFT → OPEN → ANSWERED → CLOSED  (REJECTED branch)
//  Anchor: NĐ 06/2021 Điều 19 — nhà thầu yêu cầu làm rõ thiết kế

model RFI {
  issueId            String    @id
  question           String    @db.Text
  category           String? // "Kiến trúc" | "Kết cấu" | "MEP" | "ATLĐ"
  requestedById      String // org requesting (e.g. NT_CHINH)
  respondedById      String? // org responsible to answer (e.g. TV_THIET_KE)
  answer             String?   @db.Text
  costImpactVnd      BigInt? // ước tính tác động chi phí
  scheduleImpactDays Int? // ước tính tác động tiến độ (ngày)
  needBy             DateTime?
  answeredAt         DateTime?

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  Project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}

// ─── Submittal (vật liệu / shop drawing approval) ───────────────────────────
//  States: DRAFT → SUBMITTED → UNDER_REVIEW → APPROVED | APPROVED_AS_NOTED | REVISE_RESUBMIT | REJECTED → CLOSED

model Submittal {
  issueId        String             @id
  specSection    String? // "03 30 00 — Cast-in-Place Concrete"
  materialName   String // "Bê tông M300 — Holcim"
  manufacturer   String?
  submitterOrgId String // NT_CHINH or NT_PHU
  reviewerOrgId  String? // TV_GIAM_SAT or TV_THIET_KE
  revision       Int                @default(0) // re-submit cycles
  decision       SubmittalDecision?
  decidedAt      DateTime?

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  Project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}

enum SubmittalDecision {
  APPROVED // Chấp thuận
  APPROVED_AS_NOTED // Chấp thuận với ghi chú
  REVISE_RESUBMIT // Sửa và nộp lại
  REJECTED // Từ chối
}

// ─── NCR (Non-Conformance Report) ───────────────────────────────────────────
//  States: DRAFT → OPEN → ROOT_CAUSE → CAR_PROPOSED → CAR_APPROVED → RECTIFIED → VERIFIED → CLOSED
//  Anchor: NĐ 06/2021 Điều 12 — quản lý sai khác chất lượng. CAR = Corrective Action Request.

model NCR {
  issueId          String      @id
  severity         NCRSeverity
  rootCause        String?     @db.Text
  correctiveAction String?     @db.Text
  preventiveAction String?     @db.Text
  raisedByOrgId    String // typically TV_GIAM_SAT
  responsibleOrgId String // typically NT_CHINH or NT_PHU
  costImpactVnd    BigInt?
  qcvnRef          String? // "QCVN 06:2022/BXD §3.2.1"
  rectifiedAt      DateTime?
  verifiedAt       DateTime?

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  Project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}

enum NCRSeverity {
  MINOR // không ảnh hưởng cấu trúc
  MAJOR // ảnh hưởng chất lượng, có thể sửa tại chỗ
  CRITICAL // phải tháo dỡ, làm lại
}

// ─── Punch list item (danh mục lỗi tồn đọng pre-handover) ───────────────────
//  States: OPEN → IN_PROGRESS → READY_FOR_INSPECTION → ACCEPTED | REJECTED → CLOSED

model PunchItem {
  issueId        String    @id
  trade          String // "Sơn" | "Thạch cao" | "ME"
  zone           String // "Căn 12A-05"
  photoBeforeUrl String?
  photoAfterUrl  String?
  acceptedAt     DateTime?

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  Project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}

// ─── Change Order (lệnh thay đổi) ───────────────────────────────────────────
//  States: DRAFT → ESTIMATING → SUBMITTED → CDT_REVIEW → APPROVED | REJECTED → IMPLEMENTED → CLOSED

model ChangeOrder {
  issueId           String    @id
  reason            String    @db.Text
  scopeChange       String    @db.Text
  costDeltaVnd      BigInt // dương = tăng, âm = giảm
  scheduleDeltaDays Int       @default(0)
  approvedAt        DateTime?
  approvedByUserId  String?

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  Project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}

// ─── Daily Log (nhật ký công trình) ─────────────────────────────────────────
//  NĐ 06/2021 Điều 10 — bắt buộc nhật ký thi công hàng ngày.

model DailyLog {
  id             String    @id @default(cuid())
  projectId      String
  date           DateTime  @db.Date
  authorId       String
  weather        String? // "Nắng 32°C" | "Mưa to"
  shift          Shift     @default(DAY)
  workforce      Json // [{ trade: "thợ sắt", count: 12 }, ...]
  workDone       String    @db.Text // tóm tắt công việc đã làm
  workTomorrow   String?   @db.Text
  safetyNotes    String?   @db.Text // sự cố ATLĐ / cảnh báo
  signoffByCdtId String? // GSCDT signoff
  signoffByGsId  String? // TVGS signoff
  signedAt       DateTime?
  createdAt      DateTime  @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User         @relation(fields: [authorId], references: [id])
  photos  Attachment[] @relation("DailyLogPhotos")

  @@unique([projectId, date, shift])
  @@index([projectId, date])
}

enum Shift {
  DAY
  NIGHT
}

// ============================================================================
//  MODELS module — Atlassian "Bitbucket" reskinned (BIM / drawing version control)
// ============================================================================

model DrawingSet {
  id         String     @id @default(cuid())
  projectId  String
  name       String // "Bộ thiết kế kỹ thuật v3"
  discipline Discipline
  issuedDate DateTime?
  revision   String // "R0" | "R1" | "IFC" (issued for construction)
  isCurrent  Boolean    @default(false)
  createdAt  DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sheets  Sheet[]

  @@index([projectId, discipline])
}

enum Discipline {
  KIEN_TRUC // Architectural
  KET_CAU // Structural
  CO_DIEN_M // Mechanical (HVAC)
  CO_DIEN_E // Electrical
  CO_DIEN_P // Plumbing
  PCCC // Fire-safety
  CANH_QUAN // Landscape
  HA_TANG // Civil / infra
  NOI_THAT // Interior
}

model Sheet {
  id             String  @id @default(cuid())
  drawingSetId   String
  sheetNumber    String // "A-201"
  title          String // "Mặt bằng tầng điển hình"
  scale          String? // "1:100"
  fileUrl        String // S3 key — original PDF/DWG
  thumbnailUrl   String?
  pageNumber     Int? // if multi-page PDF
  revision       String // "R0"
  supersededById String? // FK to next-revision Sheet

  drawingSet   DrawingSet @relation(fields: [drawingSetId], references: [id], onDelete: Cascade)
  supersededBy Sheet?     @relation("Supersedes", fields: [supersededById], references: [id])
  supersedes   Sheet[]    @relation("Supersedes")
  markups      Markup[]
  issues       Issue[]

  @@unique([drawingSetId, sheetNumber, revision])
}

model Markup {
  id        String   @id @default(cuid())
  sheetId   String
  authorId  String
  geometry  Json // SVG path / polygon coords
  color     String   @default("#ff3b30")
  label     String?
  createdAt DateTime @default(now())

  sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}

// BIM federated model (IFC / RVT / NWD) — viewed via Autodesk APS / Forge Viewer
model Model {
  id                     String            @id @default(cuid())
  projectId              String
  name                   String // "Federated_v12.nwd"
  discipline             Discipline?
  fileUrl                String // S3 key
  fileSizeBytes          BigInt
  format                 ModelFormat
  apsUrn                 String? // base64 URN for Forge Viewer
  apsTranslationStatus   TranslationStatus @default(PENDING)
  apsTranslationProgress Int               @default(0)
  revision               String // "v12"
  uploadedByUserId       String
  uploadedAt             DateTime          @default(now())

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  elements      ModelElement[]
  takeoffSheets TakeoffSheet[]

  @@index([projectId, discipline])
}

enum ModelFormat {
  IFC
  RVT
  NWD
  NWC
  DWG
  DXF
  PDF
  OTHER
}

enum TranslationStatus {
  PENDING
  INPROGRESS
  SUCCESS
  FAILED
  TIMEOUT
}

// ============================================================================
//  ACCEPTANCE — Nghiệm thu (per NĐ 06/2021 Điều 21, 22, 23)
// ============================================================================
//
//  Ba cấp nghiệm thu:
//    1. Nghiệm thu công việc xây dựng     (CONG_VIEC)   — Điều 21
//    2. Nghiệm thu giai đoạn / bộ phận    (GIAI_DOAN)   — Điều 22
//    3. Nghiệm thu hoàn thành công trình  (HOAN_THANH)  — Điều 23
//
//  Mỗi cấp: ma trận chữ ký CĐT–TVGS–NT, đính kèm bản vẽ + ảnh + kết quả thí nghiệm.
//  States: DRAFT → SCHEDULED → IN_PROGRESS → SIGNED → FINALIZED  (or REJECTED → REWORK)

model Acceptance {
  id            String         @id @default(cuid())
  projectId     String
  type          AcceptanceType
  code          String // "BBNT-CV-001"
  title         String // "Nghiệm thu cốt thép tầng 12 — Trục A-F"
  state         String // FSM state
  scheduledAt   DateTime?
  conductedAt   DateTime?
  finalizedAt   DateTime?
  rejectionNote String?        @db.Text
  qcvnRefs      String[] // ["QCVN 06:2022/BXD", "TCVN 5574:2018"]
  testResults   Json? // kết quả thí nghiệm vật liệu

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  signoffs    Signoff[]
  attachments Attachment[] @relation("AcceptanceAttachments")

  @@unique([projectId, code])
}

enum AcceptanceType {
  CONG_VIEC // Nghiệm thu công việc (Điều 21)
  GIAI_DOAN // Nghiệm thu giai đoạn / bộ phận (Điều 22)
  HOAN_THANH // Nghiệm thu hoàn thành (Điều 23)
}

// Multi-party signoff matrix
model Signoff {
  id           String    @id @default(cuid())
  acceptanceId String
  userId       String
  role         OrgType // CDT, TVGS, NT_CHINH, TV_THIET_KE…
  signedAt     DateTime?
  signatureUrl String? // PNG of wet signature or hash of chữ ký số
  caCertSerial String? // chữ ký số cert serial (VNPT-CA / Viettel-CA)
  rejected     Boolean   @default(false)
  rejectNote   String?

  acceptance Acceptance @relation(fields: [acceptanceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([acceptanceId, userId, role])
}

// ============================================================================
//  PROGRESS PAYMENT — Thanh toán giai đoạn (NĐ 10/2021)
// ============================================================================

model ProgressPayment {
  id            String    @id @default(cuid())
  projectId     String
  period        String // "2026-04" (YYYY-MM)
  workDoneVnd   BigInt // giá trị khối lượng hoàn thành
  vatRate       Int       @default(8) // 8% or 10%
  vatVnd        BigInt // tự tính = workDone * rate
  retentionPct  Int       @default(5) // bảo lưu 5% phổ biến
  retentionVnd  BigInt
  cumulativeVnd BigInt // luỹ kế đến kỳ này
  state         String // DRAFT → SUBMITTED → CDT_REVIEW → APPROVED → PAID
  submittedAt   DateTime?
  approvedAt    DateTime?
  paidAt        DateTime?

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applications PaymentApplication[]

  @@unique([projectId, period])
}

// ============================================================================
//  PAYMENT RAIL — Hồ sơ thanh toán (NĐ 99/2021 + TT 08/2022)
//  Đề nghị thanh toán = bộ hồ sơ: BBNT KL → Bảng tính giá trị → Phiếu giá →
//  Đẩy KBNN-DVC (vốn ngân sách) hoặc gửi CĐT (vốn tư).
// ============================================================================

model PaymentApplication {
  id                  String                 @id @default(cuid())
  projectId           String
  code                String // "TT-VHGP-S9-2026-04-001"
  period              String // "2026-04"
  paymentType         PaymentApplicationType
  fundSource          PaymentFundSource      @default(NGAN_SACH) // NS / DN / FDI / HON_HOP
  contractorOrgId     String? // nhà thầu nhận tiền
  contractRef         String? // số HĐ kinh tế
  contractValueVnd    BigInt? // giá trị HĐ tại thời điểm này (đã gồm điều chỉnh)
  progressPaymentId   String? // link tới ProgressPayment kỳ tương ứng (optional)
  workDoneVnd         BigInt // KL hoàn thành kỳ này
  cumulativeWorkVnd   BigInt // luỹ kế KL đã thực hiện
  advanceDeductionVnd BigInt                 @default(0) // khấu trừ tạm ứng
  retentionVnd        BigInt                 @default(0) // bảo lưu 5%
  vatRate             Int                    @default(8)
  vatVnd              BigInt                 @default(0)
  netPayableVnd       BigInt // = (workDone - retention - adv) + vat
  acceptanceIds       String[] // BBNT KL nghiệm thu kỳ này
  changeOrderIds      String[] // CO đã duyệt cộng vào
  attachmentIds       String[] // file đính kèm (Bảng tính, Phiếu giá PDF)
  state               String // DRAFT, NT_SIGNED, TVGS_SIGNED, CDT_APPROVED, KBNN_SUBMITTED, PAID, REJECTED
  ntSignedAt          DateTime?
  tvgsSignedAt        DateTime?
  cdtApprovedAt       DateTime?
  kbnnSubmittedAt     DateTime?
  kbnnTxId            String? // mã giao dịch DVC-KBNN
  kbnnStatus          String? // PENDING / ACCEPTED / RETURNED / PAID
  kbnnResponseJson    Json?
  paidAt              DateTime?
  paidVnd             BigInt?
  rejectionNote       String?                @db.Text
  notes               String?                @db.Text
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  progressPayment ProgressPayment? @relation(fields: [progressPaymentId], references: [id])
  contractorOrg   Organization?    @relation("PaymentContractor", fields: [contractorOrgId], references: [id])

  @@unique([projectId, code])
  @@index([projectId, period])
  @@index([state])
}

enum PaymentApplicationType {
  TAM_UNG // Tạm ứng hợp đồng (TT 08/2022 Đ.7)
  GIAI_DOAN // Thanh toán giai đoạn (theo BBNT KL)
  HOAN_THANH // Thanh toán khi hoàn thành công trình
  QUYET_TOAN // Quyết toán hợp đồng
}

enum PaymentFundSource {
  NGAN_SACH // Vốn ngân sách (đi KBNN-DVC)
  DOANH_NGHIEP // Vốn doanh nghiệp tư nhân
  FDI // Vốn đầu tư nước ngoài
  HON_HOP // Hỗn hợp
}

// ============================================================================
//  VOLUME METER — Bóc khối lượng (TT 13/2021/TT-BXD)
//  3-cột so sánh: dự toán (BoQ) ↔ thi công (đo thực) ↔ hoàn công (as-built).
//  Auto-takeoff từ IFC/RVT khi có Forge; bổ sung thủ công khi không.
// ============================================================================

model TakeoffSheet {
  id          String           @id @default(cuid())
  projectId   String
  code        String // "QTO-VHGP-S9-MONG-001"
  title       String
  scope       String // "Móng cọc trục A-F", "Cốt thép tầng 12"
  source      TakeoffSource    @default(MANUAL)
  modelId     String? // link Model nếu auto từ IFC
  state       String // DRAFT, NT_SUBMITTED, TVGS_VERIFIED, CDT_APPROVED
  totalLines  Int              @default(0)
  totalValue  BigInt           @default(0) // tổng giá trị (VND) = sum(qtyExecuted * unitPriceVnd)
  ntSubmittedAt   DateTime?
  tvgsVerifiedAt  DateTime?
  cdtApprovedAt   DateTime?
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  model   Model?         @relation(fields: [modelId], references: [id])
  lines   TakeoffLine[]

  @@unique([projectId, code])
  @@index([projectId, state])
}

model TakeoffLine {
  id              String         @id @default(cuid())
  sheetId         String
  seq             Int // số thứ tự
  workCode        String? // mã định mức AB.xxxxx theo định mức 10/2019
  description     String         @db.Text
  unit            String // "m3", "m2", "kg", "tấn", "cái"
  qtyEstimated    Decimal        @db.Decimal(18, 4) // KL dự toán (BoQ)
  qtyExecuted     Decimal        @db.Decimal(18, 4) // KL thi công đo thực
  qtyAsBuilt      Decimal?       @db.Decimal(18, 4) // KL hoàn công (sau bàn giao)
  unitPriceVnd    BigInt // đơn giá VND/đơn vị
  ifcElementId    String? // GlobalId IFC nếu auto-takeoff
  csiCode         String? // MasterFormat CSI (cross-reference)
  notes           String?

  sheet TakeoffSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@unique([sheetId, seq])
  @@index([workCode])
}

enum TakeoffSource {
  MANUAL // Bóc thủ công từ bản vẽ
  IFC_AUTO // Auto-takeoff từ IFC (Forge / IfcOpenShell)
  HYBRID // IFC + bổ sung thủ công
  IMPORTED // Import từ Excel/CSV
}

// ============================================================================
//  SPECS module — Atlassian "Confluence" reskinned
//  Project wiki: hồ sơ thiết kế text, biện pháp thi công, TCVN/QCVN refs.
// ============================================================================

model SpecPage {
  id         String    @id @default(cuid())
  projectId  String
  slug       String // "bien-phap-thi-cong-mong-coc"
  title      String
  body       String    @db.Text // markdown
  parentId   String?
  authorId   String
  // Embedding vector (bge-m3 by default → 1024 dims). Refreshed on body change.
  // Migrate to pgvector when corpus > ~10k pages — column type swap only.
  embedding  Json?
  embeddedAt DateTime?
  embedModel String?
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())

  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   SpecPage?  @relation("SpecTree", fields: [parentId], references: [id])
  children SpecPage[] @relation("SpecTree")

  @@unique([projectId, slug])
}

// ============================================================================
//  ATTACHMENTS — generic file references
// ============================================================================

model Attachment {
  id           String   @id @default(cuid())
  fileUrl      String // S3 key
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedAt   DateTime @default(now())
  issueId      String?
  dailyLogId   String?
  acceptanceId String?
  bidId        String?
  incidentId   String?

  issue      Issue?          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  dailyLog   DailyLog?       @relation("DailyLogPhotos", fields: [dailyLogId], references: [id], onDelete: Cascade)
  acceptance Acceptance?     @relation("AcceptanceAttachments", fields: [acceptanceId], references: [id], onDelete: Cascade)
  bid        Bid?            @relation("BidAttachments", fields: [bidId], references: [id], onDelete: Cascade)
  incident   IncidentReport? @relation("IncidentPhotos", fields: [incidentId], references: [id], onDelete: Cascade)
}

// ============================================================================
//  AI suggestions — outputs from OSS models (Ollama, Whisper)
//  Engineer-in-loop: every AI output is a suggestion, never auto-applied.
//  Stored even on failure so the UI can surface "AI tried but unreachable".
// ============================================================================

model AiSuggestion {
  id         String    @id @default(cuid())
  kind       String // "rfi.classify" | "rfi.draft_answer" | "ncr.assess_photo" | "daily_log.structure" | …
  entityType String // "Issue" | "DailyLog" | "SpecPage" | …
  entityId   String
  projectId  String?
  model      String // "qwen2.5:7b-instruct" | "bge-m3" | "faster-whisper-medium" | "n/a" on failure
  ok         Boolean   @default(true)
  failReason String? // when ok=false: timeout|unreachable|model_missing|invalid_response|…
  output     Json // task-specific payload (validated by zod in @atlas/ai)
  latencyMs  Int       @default(0)
  accepted   Boolean   @default(false)
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId, kind, createdAt])
  @@index([projectId, kind, createdAt])
}

// ============================================================================
//  Waitlist (landing page)
// ============================================================================

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  company   String?
  role      String? // "Chỉ huy trưởng" | "Giám đốc dự án" | "CĐT"
  size      String? // "1-10" | "11-50" | "51-200" | "200+"
  notes     String?
  source    String? // utm_source
  createdAt DateTime @default(now())
}

// ============================================================================
//  Invite (email-based org/project invitation)
// ============================================================================

model Invite {
  id          String     @id @default(cuid())
  email       String
  orgId       String
  projectId   String? // optional: scope invite to a single project
  role        MemberRole
  invitedById String
  tokenHash   String     @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([email, orgId])
  @@index([orgId])
}

// ============================================================================
//  Audit log — immutable trail (NĐ 06/2021 compliance posture, IDOR forensics)
// ============================================================================

model AuditEvent {
  id         String   @id @default(cuid())
  orgId      String?
  projectId  String?
  actorId    String? // null for system events
  action     String // "issue.create" | "issue.transition" | "auth.login" | …
  entityType String // "Issue" | "RFI" | "Project" | …
  entityId   String?
  ip         String?
  userAgent  String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  actor User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

// ============================================================================
//  WINWORK module — Bidding Intelligence
//  Tender scraping + bid workflow + bond tracking + Luật Đấu thầu 22/2023 checks
// ============================================================================

model TenderOpportunity {
  id            String       @id @default(cuid())
  source        TenderSource
  sourceUrl     String?
  sourceRef     String? // Mã TBMT (thông báo mời thầu) from source
  title         String
  invitor       String? // Bên mời thầu
  invitorMst    String?
  budgetVnd     BigInt? // Giá gói thầu
  fundingSource String? // "Vốn ngân sách" | "ODA" | "Tư nhân"
  category      String? // "Xây lắp" | "Tư vấn" | "Mua sắm" | "Hỗn hợp"
  province      String?
  district      String?
  publishedAt   DateTime?
  closingAt     DateTime?
  openingAt     DateTime?
  bidMethod     String? // "Đấu thầu rộng rãi" | "Hạn chế" | "Chỉ định" | "Chào hàng"
  bidForm       String? // "1GĐ-1TH" | "1GĐ-2TH" | "2GĐ-1TH" | "2GĐ-2TH"
  contractType  String? // "Trọn gói" | "Đơn giá cố định" | "Đơn giá điều chỉnh" | "Theo thời gian"
  rawHash       String       @unique // de-dupe content hash
  rawJson       Json? // raw source payload, re-extractable
  scrapedAt     DateTime     @default(now())

  bids Bid[]

  @@index([source, closingAt])
  @@index([province, closingAt])
}

enum TenderSource {
  MUASAMCONG // muasamcong.mpi.gov.vn — official MPI
  DAUTHAU_ASIA // dauthau.asia
  BAO_DAU_THAU // báo đấu thầu (PDF + scrape)
  MANUAL // entered by user
  OTHER
}

// Our org's response/intent on a tender — Atlas's Bid record
model Bid {
  id                String      @id @default(cuid())
  key               String      @unique // "BID-COFICO-001"
  orgId             String
  opportunityId     String?
  projectId         String? // populated when AWARDED → linked to a Project
  title             String
  state             String // FSM state (see packages/workflows/src/bid.ts)
  ownerUserId       String // bid manager
  estimatedValueVnd BigInt?
  proposedValueVnd  BigInt? // giá dự thầu
  marginPct         Float?
  contingencyPct    Float?
  technicalScore    Int? // self-assessed technical score
  financialScore    Int?
  winProbability    Float? // 0–1, computed by ML later
  submittedAt       DateTime?
  decisionAt        DateTime?
  outcome           BidOutcome?
  outcomeNote       String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  org              Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  opportunity      TenderOpportunity?   @relation(fields: [opportunityId], references: [id])
  project          Project?             @relation(fields: [projectId], references: [id])
  owner            User                 @relation("BidOwner", fields: [ownerUserId], references: [id])
  bonds            BidBond[]
  complianceChecks BidComplianceCheck[]
  documents        Attachment[]         @relation("BidAttachments")

  @@index([orgId, state])
  @@index([opportunityId])
}

enum BidOutcome {
  AWARDED
  LOST
  CANCELLED
  WITHDRAWN
  PENDING
}

// Bid bond / performance bond / advance / warranty bonds (Luật ĐT 22/2023)
model BidBond {
  id         String     @id @default(cuid())
  bidId      String
  type       BondType
  issuerBank String // "Vietcombank" | "BIDV" | …
  bondNumber String // số bảo lãnh
  amountVnd  BigInt
  issuedAt   DateTime
  expiresAt  DateTime
  feeVnd     BigInt?
  status     BondStatus @default(ACTIVE)
  releasedAt DateTime?
  fileUrl    String? // bond certificate (PDF)
  createdAt  DateTime   @default(now())

  bid Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@index([bidId])
  @@index([status, expiresAt])
}

enum BondType {
  BAO_LANH_DU_THAU // Bid bond — Luật ĐT 22/2023 Điều 14
  BAO_LANH_THUC_HIEN // Performance bond — Luật ĐT 22/2023 Điều 75
  BAO_LANH_TAM_UNG // Advance payment bond
  BAO_LANH_BAO_HANH // Warranty bond
}

enum BondStatus {
  ACTIVE
  EXPIRED
  RELEASED
  CLAIMED
}

// Compliance check result: one row per rule per bid
model BidComplianceCheck {
  id          String             @id @default(cuid())
  bidId       String
  ruleId      String // "LDT22-14-1" | "LDT22-16-1" | …
  ruleVersion String             @default("LDT-22-2023")
  ruleTitle   String
  ruleRef     String // "Luật ĐT 22/2023 Điều 14 khoản 1"
  severity    ComplianceSeverity
  status      ComplianceStatus
  evidence    Json? // structured proof / counter-proof
  note        String?            @db.Text
  checkedAt   DateTime           @default(now())

  bid Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@index([bidId, status])
}

enum ComplianceSeverity {
  INFO
  WARNING
  BLOCKING // bid cannot be submitted
}

enum ComplianceStatus {
  PASS
  FAIL
  NOT_APPLICABLE
  NEEDS_REVIEW
}

// ============================================================================
//  CODEGUARD module — TCVN/QCVN Compliance Engine
//  Library of Vietnamese standards + auto compliance-check + NĐ 15/2021
//  hồ sơ chất lượng completeness check.
// ============================================================================

// One row per Vietnamese standard / regulation.
// Examples:
//   "TCVN 5574:2018"  — Kết cấu bê tông cốt thép
//   "QCVN 06:2022/BXD" — An toàn cháy
//   "NĐ 06/2021/NĐ-CP" — Quản lý chất lượng
model Regulation {
  id          String           @id @default(cuid())
  code        String           @unique // "TCVN 5574:2018"
  kind        RegulationKind
  title       String // "Kết cấu bê tông và bê tông cốt thép — Tiêu chuẩn thiết kế"
  body        String?          @db.Text // full text or summary (markdown)
  issuedBy    String? // "Bộ Khoa học & Công nghệ" | "Bộ Xây dựng" | "Chính phủ"
  effectiveAt DateTime?
  expiresAt   DateTime?
  supersedes  String? // code of the regulation this replaces
  url         String? // public URL (LuatVietnam, MOC, …)
  status      RegulationStatus @default(IN_FORCE)
  tags        String[] // ["bê tông", "kết cấu", "PCCC"]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rules               CodeRule[]
  projectApplications ProjectRegulation[]

  @@index([kind, status])
  @@index([effectiveAt])
}

enum RegulationKind {
  TCVN // Tiêu chuẩn Việt Nam
  QCVN // Quy chuẩn kỹ thuật Việt Nam
  LUAT // Luật
  NGHI_DINH // Nghị định
  THONG_TU // Thông tư
  QUYET_DINH // Quyết định
  CONG_VAN // Công văn
}

enum RegulationStatus {
  DRAFT
  IN_FORCE
  SUSPENDED
  SUPERSEDED // replaced by a newer regulation
}

// Project-scoped applicability: which regulations apply to which project,
// optionally with an override/note.
model ProjectRegulation {
  id           String   @id @default(cuid())
  projectId    String
  regulationId String
  required     Boolean  @default(true) // false → only advisory on this project
  note         String?  @db.Text
  createdAt    DateTime @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  regulation Regulation @relation(fields: [regulationId], references: [id])

  @@unique([projectId, regulationId])
}

// Individual machine-checkable rules extracted from a regulation.
// Example: TCVN 5574:2018 §10.3.1 → "Lớp bê tông bảo vệ cốt thép cột ≥ 25mm"
//          QCVN 06:2022/BXD §3.2.1 → "Chiều rộng hành lang căn hộ ≥ 1.5m"
model CodeRule {
  id           String       @id @default(cuid())
  regulationId String
  code         String // "TCVN-5574-10.3.1" — internal stable ID
  clauseRef    String // "§10.3.1 khoản 2"
  title        String // "Lớp bê tông bảo vệ cốt thép cột"
  description  String?      @db.Text
  severity     CodeSeverity @default(WARNING)
  category     String? // "kết cấu" | "PCCC" | "tiếp cận KT" | …
  // Optional declarative check spec (JSON). Interpreted by codeguard runner.
  check        Json?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  regulation Regulation        @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  findings   CodeRuleFinding[]

  @@unique([regulationId, code])
  @@index([category, severity])
}

enum CodeSeverity {
  INFO
  WARNING
  BLOCKING // không được nghiệm thu / xin phép
}

// Persisted finding from running a rule against an entity in the project.
// `entityType` / `entityId` is a soft FK so the same engine can target
// Submittals, drawings (Sheet), models (Model), acceptances, etc.
model CodeRuleFinding {
  id         String           @id @default(cuid())
  projectId  String
  ruleId     String
  entityType String
  entityId   String
  status     ComplianceStatus
  evidence   Json?
  note       String?          @db.Text
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())

  rule CodeRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([projectId, status, createdAt])
  @@index([entityType, entityId])
}

// Hồ sơ chất lượng công trình — NĐ 15/2021 Điều 26 + Phụ lục I.
// Each row tracks one required document type for a project.
model QualityDossierItem {
  id          String          @id @default(cuid())
  projectId   String
  category    DossierCategory
  itemCode    String // "I.A.1" | "I.B.4" — anchor to NĐ 15/2021 phụ lục
  itemTitle   String
  required    Boolean         @default(true)
  status      DossierStatus   @default(MISSING)
  evidenceUrl String? // S3 key for the uploaded evidence
  uploadedAt  DateTime?
  reviewedAt  DateTime?
  reviewerId  String? // user id of TVGS/CĐT who verified
  note        String?         @db.Text
  createdAt   DateTime        @default(now())

  @@unique([projectId, itemCode])
  @@index([projectId, status])
}

enum DossierCategory {
  KHAO_SAT // Hồ sơ khảo sát
  THIET_KE // Hồ sơ thiết kế
  THI_CONG // Hồ sơ thi công
  NGHIEM_THU // Hồ sơ nghiệm thu
  HOAN_CONG // Hồ sơ hoàn công
}

enum DossierStatus {
  MISSING
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
}

// ============================================================================
//  DRAWBRIDGE module — BIM/CAD intelligence (extends Models)
//  ModelElement (BIM element registry) + Clash + IssueElementLink
// ============================================================================

// Named element extracted from an IFC/RVT model — "Cột C-12 tầng 5", "Dầm B-3"
// Acts as the anchor for issues, clashes, photos, and 4D schedule.
model ModelElement {
  id         String      @id @default(cuid())
  modelId    String
  elementId  String // IFC GlobalId or APS dbId stringified
  name       String // "Column C-12" | "Cột C-12 tầng 5"
  category   String // "Cột" | "Dầm" | "Tường" | "Sàn" | "MEP-Pipe" | …
  discipline Discipline?
  level      String? // "Tầng 5"
  zone       String? // "Khu A"
  ifcType    String? // "IfcColumn" | "IfcBeam"
  // Optional axis-aligned bounding box: [minX, minY, minZ, maxX, maxY, maxZ]
  bbox       Float[]
  properties Json? // arbitrary IFC psets
  createdAt  DateTime    @default(now())

  model      Model              @relation(fields: [modelId], references: [id], onDelete: Cascade)
  clashesA   Clash[]            @relation("ClashElementA")
  clashesB   Clash[]            @relation("ClashElementB")
  issueLinks IssueElementLink[]

  @@unique([modelId, elementId])
  @@index([modelId, category])
  @@index([discipline, level])
}

// Clash between two elements (usually cross-discipline: MEP ⨯ Struct)
model Clash {
  id          String        @id @default(cuid())
  projectId   String
  elementAId  String
  elementBId  String
  category    ClashCategory @default(HARD)
  description String?       @db.Text
  // Severity scored 0-100 (volume overlap heuristic). Used for triage.
  severity    Int           @default(50)
  status      ClashStatus   @default(OPEN)
  detectedAt  DateTime      @default(now())
  resolvedAt  DateTime?
  // When a clash is escalated to an issue (RFI/NCR/etc.), we point at it.
  issueId     String?

  elementA ModelElement @relation("ClashElementA", fields: [elementAId], references: [id], onDelete: Cascade, map: "Clash_elementA_fkey")
  elementB ModelElement @relation("ClashElementB", fields: [elementBId], references: [id], onDelete: Cascade, map: "Clash_elementB_fkey")

  @@index([projectId, status])
  @@index([elementAId])
  @@index([elementBId])
}

enum ClashCategory {
  HARD // Physical overlap
  CLEARANCE // Insufficient clearance
  WORKFLOW // Sequencing / 4D
}

enum ClashStatus {
  OPEN
  TRIAGED // assigned, scheduled
  RESOLVED // fix verified
  IGNORED // false positive / waived
}

// Join table: issue (any kind) ↔ BIM element. Many-to-many because one RFI
// may reference multiple elements (e.g. "cột C-11, C-12, C-13").
model IssueElementLink {
  id        String   @id @default(cuid())
  issueId   String
  elementId String
  note      String?
  createdAt DateTime @default(now())

  issue   Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  element ModelElement @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@unique([issueId, elementId])
  @@index([elementId])
}

// ============================================================================
//  SITEEYE module — Computer Vision + Safety + Weather
// ============================================================================

model SiteCamera {
  id        String   @id @default(cuid())
  projectId String
  name      String // "Cổng chính" | "Khu A — tầng 2"
  streamUrl String? // RTSP/HLS URL (private)
  location  String? // "Tầng 5, hướng Bắc"
  // Optional GPS for outdoor cams
  lat       Float?
  lng       Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  events VisionEvent[]

  @@index([projectId, active])
}

// One row per vision-pipeline detection (PPE, intrusion, worker count, etc.)
// Confidence score is the model's output 0-1.
model VisionEvent {
  id           String     @id @default(cuid())
  projectId    String
  cameraId     String?
  kind         VisionKind
  ts           DateTime   @default(now())
  confidence   Float      @default(0)
  // Bounding box (px) in source frame
  bbox         Int[]
  // Class label string ("hard_hat_missing" | "safety_vest_missing" | "person")
  label        String
  frameUrl     String? // S3 key of the saved frame
  // Free-form payload from the model (counts, attributes, …)
  payload      Json?
  // Worker who reviewed this event
  reviewedBy   String?
  reviewedAt   DateTime?
  acknowledged Boolean    @default(false)

  camera SiteCamera? @relation(fields: [cameraId], references: [id], onDelete: SetNull)

  @@index([projectId, kind, ts])
  @@index([projectId, acknowledged])
}

enum VisionKind {
  PPE_VIOLATION // missing hard hat / vest / harness / boots
  WORKER_COUNT // headcount snapshot
  INTRUSION // person in exclusion zone
  FIRE_SMOKE
  CRANE_SWING
  VEHICLE
}

// Weather observation / forecast snapshot — drives concreting / lifting alerts.
model WeatherSnapshot {
  id        String   @id @default(cuid())
  projectId String
  ts        DateTime @default(now())
  tempC     Float?
  humidity  Float?
  rainMmHr  Float?
  windKph   Float?
  condition String? // "rain_heavy" | "thunder" | "clear" | …
  source    String? // "open-meteo" | "manual"
  payload   Json?

  @@index([projectId, ts])
}

// On-site incident (sự cố ATLĐ) — Luật ATVSLĐ 84/2015 + NĐ 39/2016
model IncidentReport {
  id               String           @id @default(cuid())
  projectId        String
  reporterId       String
  occurredAt       DateTime
  reportedAt       DateTime         @default(now())
  category         IncidentCategory
  severity         IncidentSeverity
  description      String           @db.Text
  location         String?
  injured          Int              @default(0)
  rootCause        String?          @db.Text
  immediateAction  String?          @db.Text
  preventiveAction String?          @db.Text
  closedAt         DateTime?
  // Optional uplink to a NCR / SAFETY Issue for the workflow trail
  issueId          String?

  photos Attachment[] @relation("IncidentPhotos")

  @@index([projectId, occurredAt])
  @@index([severity, closedAt])
}

enum IncidentCategory {
  AN_TOAN_LAO_DONG // tai nạn lao động
  CHAY_NO // cháy nổ
  SUP_DO // sụp đổ kết cấu
  ROI_NGA // rơi/ngã từ cao
  DIEN_GIAT
  HOA_CHAT
  MOI_TRUONG
  KHAC
}

enum IncidentSeverity {
  NEAR_MISS // suýt xảy ra
  MINOR // chấn thương nhẹ
  MAJOR // chấn thương nặng / mất ngày công
  CRITICAL // tử vong / sự cố lớn
}

// ============================================================================
//  COSTPULSE module — Cost Intelligence (BoQ, EVM, payment milestones)
// ============================================================================

// Bill of Quantities — root of cost tracking per project.
// One BoQ per major phase / contract; lines hang off this.
model BoQ {
  id               String   @id @default(cuid())
  projectId        String
  name             String // "BoQ hợp đồng thi công chính"
  contractValueVnd BigInt // tổng giá trị BoQ
  version          String   @default("v1")
  isCurrent        Boolean  @default(true)
  createdAt        DateTime @default(now())

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lines   BoQLine[]

  @@index([projectId, isCurrent])
}

model BoQLine {
  id           String   @id @default(cuid())
  boqId        String
  code         String // "1.2.3" hierarchy code from BoQ spreadsheet
  description  String   @db.Text
  unit         String // "m³" | "kg" | "m²" | "cái"
  qty          Float
  unitPriceVnd BigInt
  totalVnd     BigInt // = qty * unitPrice
  // Cumulative completed quantity (updated by progress payments)
  qtyCompleted Float    @default(0)
  category     String? // "Phần ngầm" | "Phần thân" | "MEP" | "Hoàn thiện" | …
  costCode     String? // accounting cost-code alignment (optional)
  createdAt    DateTime @default(now())

  boq BoQ @relation(fields: [boqId], references: [id], onDelete: Cascade)

  @@unique([boqId, code])
  @@index([boqId, category])
}

// Vietnamese construction material price index — Bộ Xây dựng publishes
// monthly per province for: thép xây dựng, xi măng, cát, đá, gạch, sơn…
model MaterialPriceIndex {
  id        String   @id @default(cuid())
  province  String // "TP. HCM"
  material  String // "Thép thanh CB300-V" | "Xi măng PCB40"
  unit      String // "kg" | "tấn" | "m³"
  priceVnd  BigInt
  period    String // "2026-04" (YYYY-MM)
  source    String? // "Sở XD TP.HCM CV-415/SXD" | "Vneconomy"
  createdAt DateTime @default(now())

  @@unique([province, material, period])
  @@index([material, period])
}

// Subcontractor scorecard — performance tracking
model SubcontractorScore {
  id            String   @id @default(cuid())
  orgId         String // the subcontractor (org with type NHA_THAU_PHU)
  projectId     String? // null for cross-project rolling score
  period        String // "2026-Q1"
  priceScore    Int // 0-100
  qualityScore  Int // 0-100
  scheduleScore Int // 0-100
  safetyScore   Int // 0-100
  overallScore  Int // 0-100 (weighted)
  note          String?  @db.Text
  createdAt     DateTime @default(now())

  @@unique([orgId, projectId, period])
  @@index([orgId, period])
}

// Cost overrun signal — fired by detector, surfaced in ProjectPulse risk heatmap.
model CostOverrunSignal {
  id            String          @id @default(cuid())
  projectId     String
  category      String? // "labour" | "material" | "subcontract"
  forecastedVnd BigInt
  baselineVnd   BigInt
  deltaPct      Float // = (forecast-baseline) / baseline
  weeksAhead    Int             @default(0) // how early was this detected (Lyapunov-style lead time)
  severity      OverrunSeverity @default(WATCH)
  status        OverrunStatus   @default(OPEN)
  evidence      Json?
  createdAt     DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, createdAt])
}

enum OverrunSeverity {
  WATCH // 5-10% over
  ALERT // 10-20% over
  CRITICAL // > 20% over
}

enum OverrunStatus {
  OPEN
  MITIGATING
  RESOLVED
  ACCEPTED_OVERRUN
}

// ============================================================================
//  LAYER 2 — Operational Backbone (workflow designer, recurring, chat, SLAs)
// ============================================================================

// Custom workflow template — drag-drop designer output stored as JSON DAG.
model WorkflowTemplate {
  id          String        @id @default(cuid())
  orgId       String?
  name        String
  scope       WorkflowScope @default(ORG) // ORG | PROJECT | PUBLIC
  description String?       @db.Text
  // DAG: { nodes: [{id, type:"approval"|"task"|"branch", role, sla}], edges: [...]}
  dag         Json
  version     Int           @default(1)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orgId, isActive])
}

enum WorkflowScope {
  ORG // private to creating org
  PROJECT // attached to one project
  PUBLIC // shared template gallery
}

// Recurring task definition — e.g. "daily site report every weekday 17:00"
model RecurringTask {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  template    Json // task fields template
  cron        String // cron expression "0 17 * * 1-5"
  active      Boolean   @default(true)
  lastFiredAt DateTime?
  nextFireAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([projectId, active, nextFireAt])
}

// Project chat channel — Slack-style for team comms
model ChatChannel {
  id        String   @id @default(cuid())
  projectId String?
  orgId     String?
  name      String
  topic     String?
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())

  messages ChatMessage[]

  @@index([projectId])
}

model ChatMessage {
  id          String   @id @default(cuid())
  channelId   String
  authorId    String
  body        String   @db.Text
  threadId    String? // reply-thread root
  attachments Json? // [{ fileUrl, fileName }]
  createdAt   DateTime @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

// SLA breaches per workflow node — for reporting + escalation
model SlaBreach {
  id          String    @id @default(cuid())
  issueId     String?
  workflowId  String?
  stepKey     String // node id in DAG
  dueAt       DateTime
  breachedAt  DateTime  @default(now())
  escalatedTo String? // userId
  resolvedAt  DateTime?

  @@index([issueId])
  @@index([breachedAt])
}

// ============================================================================
//  LAYER 3 — Agentic Layer (goal-oriented + tool use + memory + escalation)
// ============================================================================

// Agent definition — named role-bound LLM with permitted tools + memory.
model Agent {
  id             String    @id @default(cuid())
  orgId          String?
  name           String // "PM Agent" | "Cost Agent" | "Safety Agent"
  systemPrompt   String    @db.Text
  model          String // "qwen2.5:7b-instruct" | "llama3:70b"
  tools          String[] // ["calendar.create", "issue.create", "email.send", ...]
  escalationTier AgentTier @default(AUTO_REVIEW)
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now())

  runs AgentRun[]

  @@index([orgId, enabled])
}

enum AgentTier {
  AUTO // execute without human review (low-risk tasks)
  AUTO_REVIEW // execute, but a human sees + can revert
  HUMAN_APPROVE // proposal only, human must approve before execute
}

// Each run = one (goal → plan → execute → result) cycle.
// Plans/results are persisted JSON so the UI can show "agent thought
// process" and the user can pin/replay.
model AgentRun {
  id          String         @id @default(cuid())
  agentId     String
  projectId   String?
  userId      String // who requested it
  goal        String         @db.Text
  plan        Json? // step-by-step plan emitted by the agent
  steps       Json? // executed steps with tool I/O
  result      Json?
  status      AgentRunStatus @default(PENDING)
  errorReason String?
  startedAt   DateTime       @default(now())
  endedAt     DateTime?

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
  @@index([agentId, status])
}

enum AgentRunStatus {
  PENDING
  PLANNING
  AWAITING_APPROVAL
  EXECUTING
  SUCCEEDED
  FAILED
  CANCELLED
}

// Agent persistent memory keyed by (project, agent, key) — used as RAG anchor
// across runs.
model AgentMemory {
  id        String   @id @default(cuid())
  agentId   String
  projectId String?
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([agentId, projectId, key])
}

// ============================================================================
//  LAYER 4 — MLOps & Trust (Sophie's PhD moat)
//  Model cards, citations, drift, lineage, bias audits, right-to-explanation
// ============================================================================

// Public model card per AI feature — surface in /settings/ai for end users.
// One row per (modelName, version). Versioning is critical for the audit log.
model ModelCard {
  id                  String   @id @default(cuid())
  feature             String // "rfi.classify" | "ncr.assess_photo" | "siteeye.ppe"
  modelName           String // "qwen2.5:7b-instruct"
  modelVersion        String // "2025-10-12"
  trainingDataSummary String?  @db.Text
  intendedUse         String?  @db.Text
  limitations         String?  @db.Text
  benchmarkResults    Json? // [{ name: "VN-RFI-300", accuracy: 0.78 }]
  datasetCitations    String[]
  fairnessSummary     String?  @db.Text
  publishedAt         DateTime @default(now())

  @@unique([feature, modelName, modelVersion])
}

// One citation row per AI claim — link to the source data so user can verify.
model AiCitation {
  id           String   @id @default(cuid())
  suggestionId String // FK to AiSuggestion.id (soft FK to avoid Prisma N+1)
  claim        String   @db.Text
  sourceType   String // "spec_page" | "regulation" | "rfi" | "prior_decision"
  sourceId     String?
  sourceQuote  String?  @db.Text
  confidence   Float
  createdAt    DateTime @default(now())

  @@index([suggestionId])
}

// Right-to-explanation requests from users.
model ExplanationRequest {
  id           String    @id @default(cuid())
  userId       String
  suggestionId String // which AI output the user is asking about
  question     String?   @db.Text
  explanation  String?   @db.Text
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// Drift detection snapshot — emitted periodically by the MLOps pipeline.
// Lyapunov-style stability metric (`stabilityScore`) is the unique anchor.
model DriftSnapshot {
  id             String     @id @default(cuid())
  feature        String // "rfi.classify"
  modelVersion   String
  windowStart    DateTime
  windowEnd      DateTime
  // Distribution metrics
  inputKLDiv     Float?
  outputKLDiv    Float?
  acceptanceRate Float? // % of suggestions accepted by user in this window
  // Sophie's Lyapunov-style stability score: smaller = more stable
  stabilityScore Float?
  alertLevel     DriftAlert @default(OK)
  payload        Json?
  createdAt      DateTime   @default(now())

  @@index([feature, modelVersion, windowEnd])
}

enum DriftAlert {
  OK
  WATCH
  DEGRADED
  REQUIRES_RETRAIN
}

// Data lineage — which dataset trained which model.
model DataLineage {
  id          String    @id @default(cuid())
  modelCardId String
  datasetRef  String // "internal-rfi-corpus-2025q3" | "huggingface://acme/vn-spec"
  rows        Int?
  hash        String? // SHA-256 of dataset manifest
  collectedAt DateTime?
  notes       String?   @db.Text

  @@index([modelCardId])
}

// Bias audit run — fairness across roles, org-type, gender (where applicable).
model BiasAudit {
  id           String   @id @default(cuid())
  feature      String
  modelVersion String
  dimension    String // "role" | "gender" | "region"
  results      Json // { "OWNER": { accuracy: 0.81 }, "FIELD": { accuracy: 0.68 } }
  alertLevel   String   @default("ok") // ok | watch | fail
  auditedAt    DateTime @default(now())

  @@index([feature, modelVersion])
}

// AI cost / usage telemetry — for transparency dashboard.
model AiCostEvent {
  id         String   @id @default(cuid())
  projectId  String?
  feature    String
  model      String
  tokensIn   Int      @default(0)
  tokensOut  Int      @default(0)
  latencyMs  Int      @default(0)
  // Cost in VND of this call (0 for self-hosted but stored for fairness vs hosted variants).
  costVnd    BigInt   @default(0)
  occurredAt DateTime @default(now())

  @@index([projectId, occurredAt])
  @@index([feature, occurredAt])
}

// ============================================================================
//  LAYER 5 — VN-Native (Zalo, e-invoice, feng-shui, CCCD OCR, lunar calendar)
// ============================================================================

// Zalo OA / Mini-App link per user.
model ZaloIdentity {
  id           String   @id @default(cuid())
  userId       String   @unique
  zaloUserId   String   @unique
  phone        String?
  oaFollowerId String? // when user follows the OA
  linkedAt     DateTime @default(now())
}

// Outbound message log (Zalo OA / SMS / Email).
model OutboundMessage {
  id          String     @id @default(cuid())
  channel     MsgChannel
  toRef       String // userId / orgId / external phone / external email
  template    String // template key
  body        String     @db.Text
  status      MsgStatus  @default(PENDING)
  providerId  String? // Zalo message id / SMS gateway id
  errorReason String?
  sentAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([channel, status, createdAt])
}

enum MsgChannel {
  EMAIL
  SMS
  ZALO_OA
  ZALO_MINI_APP
  WHATSAPP
  TELEGRAM
  IN_APP
}

enum MsgStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

// Hóa đơn điện tử per TT 78/2021 — outbound invoices to CĐT.
model EInvoice {
  id             String   @id @default(cuid())
  projectId      String
  paymentId      String? // optional FK to ProgressPayment
  invoiceNumber  String   @unique // "0000001"
  serialNumber   String // "1C26TAA" — sêri hóa đơn
  templateNumber String // mẫu số 1
  issueDate      DateTime
  buyerName      String
  buyerMst       String
  sellerName     String
  sellerMst      String
  subtotalVnd    BigInt
  vatRate        Int      @default(8) // 8% or 10%
  vatVnd         BigInt
  totalVnd       BigInt
  cqtCode        String? // mã CQT (cơ quan thuế) sau khi cấp
  cqtStatus      String   @default("PENDING") // PENDING | ISSUED | REJECTED
  xmlPayload     String?  @db.Text // signed XML
  pdfUrl         String?
  createdAt      DateTime @default(now())

  @@index([projectId, issueDate])
  @@index([cqtStatus])
}

// Feng-shui analysis per floor plan / unit — phongthuy-floorplan sibling logic.
model FengShuiAnalysis {
  id              String   @id @default(cuid())
  projectId       String
  unitCode        String // "S9-08A" — căn / lô / lô liền
  facingDirection String? // "Đông Nam"
  ownerBirthYear  Int? // dùng để xác định mệnh / cung
  menh            String? // "Kim" | "Mộc" | "Thuỷ" | "Hoả" | "Thổ"
  cungMenh        String? // "Càn" | "Khôn" | …
  scoreOverall    Int? // 0-100
  findings        Json? // [{ aspect: "cua_chinh", goodBad: "tot", note: "..." }]
  modelVersion    String? // FengShui model version (for trust)
  createdAt       DateTime @default(now())

  @@unique([projectId, unitCode])
}

// Vietnamese ID OCR cache (CCCD/CMND/Passport) — for onboarding workers.
model IdCardScan {
  id            String    @id @default(cuid())
  userId        String?
  cardType      String // "CCCD" | "CMND" | "PASSPORT"
  number        String
  fullName      String
  dob           DateTime?
  address       String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  imageUrl      String?
  ocrConfidence Float?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

// Lunar calendar entries marked as "ngày tốt" — surfaced by 4D scheduler.
model LunarEvent {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  lunarDate String // "Mùng 5 tháng Giêng (Bính Ngọ)"
  category  String // "khoi_cong" | "do_be_tong" | "khanh_thanh" | "ky_huy"
  good      Boolean
  note      String?

  @@unique([date, category])
}

// ============================================================================
//  LAYER 6 — Integration & Ecosystem (API, webhook, connector, OAuth apps)
// ============================================================================

// Long-lived API token issued per org. Scopes are space-separated.
model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  keyHash    String    @unique // SHA-256 of secret
  prefix     String // first 8 chars (visible in UI for identification)
  scopes     String[] // ["issues:read", "issues:write", "boq:write", ...]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([orgId])
}

// Subscribed webhooks — fired on domain events.
model Webhook {
  id             String    @id @default(cuid())
  orgId          String
  name           String
  url            String
  events         String[] // ["issue.created", "rfi.answered", ...]
  secret         String // shared secret for HMAC signing
  active         Boolean   @default(true)
  failureCount   Int       @default(0)
  lastDeliveryAt DateTime?
  createdAt      DateTime  @default(now())

  deliveries WebhookDelivery[]

  @@index([orgId, active])
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  event        String
  payload      Json
  attempt      Int      @default(1)
  responseCode Int?
  responseBody String?  @db.Text
  ok           Boolean  @default(false)
  deliveredAt  DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, deliveredAt])
}

// Pre-built connector instance (per org+system pair).
// Examples: MISA AMIS for accounting, Base Suite, BIM 360, Odoo, Procore, M365, GSuite.
model Connector {
  id             String    @id @default(cuid())
  orgId          String
  system         String // "MISA_AMIS" | "BASE" | "BIM360" | "M365" | "ZALO_OA" | …
  displayName    String
  // Credentials encrypted at-rest by the application layer.
  credentialsEnc String    @db.Text
  config         Json? // sync direction, mapping, …
  active         Boolean   @default(true)
  lastSyncAt     DateTime?
  status         String    @default("PENDING") // PENDING | OK | ERROR
  errorReason    String?
  createdAt      DateTime  @default(now())

  @@unique([orgId, system])
  @@index([orgId, active])
}

// ============================================================================
//  LAYER 7 — UX / Mobile / Offline / Push
// ============================================================================

// Device push token (FCM / APNs / web-push) for field-worker mobile + browser.
model DevicePushToken {
  id         String   @id @default(cuid())
  userId     String
  platform   String // "ios" | "android" | "web"
  token      String   @unique
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId, active])
}

// Offline-first queue — mobile clients enqueue ops while offline, server
// drains the queue when connectivity returns.
model OfflineSyncOp {
  id          String    @id @default(cuid())
  userId      String
  deviceId    String
  opType      String // "issue.create" | "daily_log.create" | "incident.create" | …
  payload     Json
  appliedAt   DateTime?
  status      String    @default("PENDING") // PENDING | APPLIED | CONFLICT | FAILED
  errorReason String?
  createdAt   DateTime  @default(now())

  @@index([userId, status, createdAt])
}

// ============================================================================
//  LAYER 8 — GTM / Pricing / Subscriptions
// ============================================================================

model Plan {
  id          String   @id @default(cuid())
  code        String   @unique // "free" | "pro" | "business" | "enterprise"
  name        String
  // Pricing config — leaving as JSON so we can model tiers + per-AI-action
  pricingJson Json
  features    Json // feature flags + limits
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Subscription {
  id            String    @id @default(cuid())
  orgId         String    @unique
  planId        String
  startedAt     DateTime  @default(now())
  renewsAt      DateTime?
  cancelledAt   DateTime?
  // Pay-per-AI-action balance — top-up VND
  aiCreditVnd   BigInt    @default(0)
  paymentMethod String? // "VNPAY" | "MOMO" | "BANK_TRANSFER" | "STRIPE"
  status        String    @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELLED

  @@index([planId])
}

// Net Promoter Score capture — per org per quarter
model NpsResponse {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  score     Int // 0-10
  comment   String?  @db.Text
  segment   String? // role at time of survey
  surveyKey String // "2026-Q2"
  createdAt DateTime @default(now())

  @@unique([orgId, userId, surveyKey])
  @@index([surveyKey])
}

// Referral tracking
model Referral {
  id            String   @id @default(cuid())
  referrerOrgId String
  code          String   @unique
  inviteeEmail  String?
  signedUpOrgId String?
  rewardVnd     BigInt?
  rewardPaid    Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([referrerOrgId])
}

// Template gallery (free templates marketplace + ISV skills)
model TemplateListing {
  id          String       @id @default(cuid())
  authorOrgId String?
  kind        TemplateKind
  title       String
  description String?      @db.Text
  payload     Json // workflow DAG / spec / boq sample / agent skill manifest
  priceVnd    BigInt? // null = free
  downloads   Int          @default(0)
  rating      Float?
  createdAt   DateTime     @default(now())

  @@index([kind])
}

enum TemplateKind {
  WORKFLOW
  SPEC
  BOQ
  BIM_FAMILY
  AGENT_SKILL
  CHECKLIST
}

// ============================================================================
//  CREWS module — Atlassian "Trello" reskinned for tổ đội thi công
//  Daily/weekly look-ahead board. Cards = work items assigned to crews.
// ============================================================================

model Crew {
  id          String   @id @default(cuid())
  projectId   String
  name        String // "Tổ thép #1" | "Tổ MEP A"
  trade       String // "Thép" | "Bê tông" | "MEP" | "Sơn" | "Hoàn thiện"
  foremanName String? // Tổ trưởng
  headcount   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  assignments CrewAssignment[]

  @@index([projectId, active])
}

// One work assignment for a crew on a specific shift.
// State machine: PLANNED → IN_PROGRESS → DONE  (with BLOCKED branch)
model CrewAssignment {
  id            String        @id @default(cuid())
  projectId     String
  crewId        String
  workDate      DateTime      @db.Date
  shift         Shift         @default(DAY)
  title         String // "Buộc thép cột tầng 12 trục A-F"
  description   String?       @db.Text
  zone          String? // "Tầng 12 — Khu A"
  state         CrewWorkState @default(PLANNED)
  blockedReason String? // populated when state = BLOCKED
  hoursPlanned  Float?
  hoursActual   Float?
  // Optional: link to upstream Issue (RFI/Submittal/Daily Log) for traceability
  issueId       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  crew Crew @relation(fields: [crewId], references: [id], onDelete: Cascade)

  @@index([projectId, workDate, shift])
  @@index([crewId, workDate])
}

enum CrewWorkState {
  PLANNED // Look-ahead planned
  IN_PROGRESS // Tổ đang làm
  BLOCKED // Đợi vật tư / bản vẽ / nghiệm thu
  DONE // Hoàn thành ca/ngày
  REVIEWED // TVGS / chỉ huy đã xác nhận
}

// ============================================================================
//  CATALOG module — Atlassian "Compass" reskinned for cấu kiện · vật tư
// ============================================================================

model CatalogItem {
  id                   String          @id @default(cuid())
  projectId            String? // null = global catalog (shared across projects)
  code                 String // "BT-M300" | "THEP-CB300-V-D14"
  name                 String // "Bê tông M300" | "Cốt thép CB300-V Φ14"
  category             CatalogCategory
  unit                 String // "m³" | "kg" | "tấn"
  spec                 String?         @db.Text // technical spec / TCVN ref
  baselineUnitPriceVnd BigInt? // reference price, used for variance flags
  imageUrl             String?
  active               Boolean         @default(true)
  createdAt            DateTime        @default(now())

  suppliers SupplierCatalogItem[]

  @@unique([projectId, code])
  @@index([category, active])
}

enum CatalogCategory {
  BE_TONG // Bê tông
  COT_THEP // Cốt thép
  GACH_DA // Gạch · đá
  XI_MANG_VOI // Xi măng · vôi
  SON_PHU // Sơn · phụ gia hoàn thiện
  ME_HVAC // M&E · HVAC
  ME_DIEN // M&E · Điện
  ME_NUOC // M&E · Cấp/thoát nước
  PCCC // Vật tư PCCC
  CUA_KINH // Cửa · kính · nhôm
  THIET_BI_THI_CONG // Thiết bị thi công
  KHAC // Khác
}

model Supplier {
  id        String   @id @default(cuid())
  orgId     String? // FK to Organization if supplier is also an org in the system
  name      String // "CTCP Thép Hòa Phát" | "Tổng cty Xi măng VN"
  mst       String? // MST nhà cung cấp
  phone     String?
  email     String?
  address   String?
  rating    Float? // 0-5 — rolling average of project ratings
  notes     String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  items SupplierCatalogItem[]

  @@index([name])
  @@index([active])
}

// Many-to-many: supplier × catalog item with price + lead time.
model SupplierCatalogItem {
  id            String    @id @default(cuid())
  supplierId    String
  catalogItemId String
  unitPriceVnd  BigInt
  leadTimeDays  Int       @default(7)
  minOrderQty   Float?
  validFrom     DateTime  @default(now())
  validTo       DateTime?
  notes         String?

  supplier Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  item     CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([supplierId, catalogItemId, validFrom])
  @@index([catalogItemId, unitPriceVnd])
}

// ============================================================================
//  HANDOVER module — Atlassian "Jira SM" reskinned for warranty desk
//  Post-bàn giao tickets per NĐ 06/2021 (12/24/60 tháng bảo hành).
// ============================================================================

model HandoverTicket {
  id                        String           @id @default(cuid())
  projectId                 String
  ticketNumber              String // "HG-VHGP-S9-001"
  unitCode                  String? // "S9-12A-05" — căn / lô / unit
  category                  HandoverCategory
  severity                  HandoverSeverity @default(LOW)
  title                     String
  description               String           @db.Text
  reporterName              String // Cư dân / CĐT báo lỗi (có thể không là user trong hệ thống)
  reporterPhone             String?
  reporterEmail             String?
  reportedAt                DateTime         @default(now())
  // Warranty window check — NĐ 06/2021: 12 tháng phần phụ, 24 phần chính, 60 hạ tầng
  warrantyType              WarrantyType
  warrantyEndsAt            DateTime
  state                     HandoverState    @default(NEW)
  slaDueAt                  DateTime? // computed from severity
  assigneeOrgId             String? // typically NT_CHINH or NT_PHU responsible
  rectifiedAt               DateTime?
  verifiedAt                DateTime?
  customerSatisfactionScore Int? // 1-5 from reporter after closure
  // Optional uplink to Issue for the workflow trail
  issueId                   String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  @@index([projectId, state])
  @@index([slaDueAt, state])
  @@index([warrantyEndsAt])
}

enum HandoverCategory {
  THAM_DOT // Thấm dột
  NUT_TUONG // Nứt tường / trần
  DIEN_GIAT // Sự cố điện
  CAP_THOAT_NUOC // Cấp / thoát nước
  HVAC // Điều hòa, thông gió
  SON_HOAN_THIEN // Sơn / hoàn thiện
  CUA_KHOA // Cửa, khóa, bản lề
  AN_NINH // Camera, kiểm soát ra vào
  KHAC
}

enum HandoverSeverity {
  LOW // 7 ngày SLA
  MEDIUM // 3 ngày
  HIGH // 24h
  CRITICAL // 4h (rò điện, sập trần, vỡ ống)
}

enum HandoverState {
  NEW // Vừa báo
  TRIAGED // Đã phân loại + giao đội xử lý
  IN_PROGRESS // Đang xử lý tại hiện trường
  AWAITING_PARTS // Đợi vật tư / phụ kiện
  RECTIFIED // Khắc phục xong, chờ xác nhận
  VERIFIED // Cư dân/CĐT xác nhận
  REJECTED // Ngoài phạm vi bảo hành
  CLOSED
}

enum WarrantyType {
  PHAN_PHU // 12 tháng — sơn, gạch, phụ kiện
  PHAN_CHINH // 24 tháng — kết cấu, MEP cố định
  HA_TANG // 60 tháng — đường, cấp nước hạ tầng
}

// ============================================================================
//  SCHEDULE module — Gantt + đường găng CPM
// ============================================================================
//  Light model — one row per scheduled task. CPM relationships kept in
//  ScheduleDependency (FS/SS/FF/SF). The aec-platform/schedule page renders
//  this as a Gantt bar with cross-project filtering.

model ScheduleTask {
  id           String            @id @default(cuid())
  projectId    String
  code         String // "T1.2.3" — WBS code
  name         String
  discipline   String? // "Phần ngầm" | "Kết cấu" | "MEP" | "Hoàn thiện"
  zone         String? // "Tầng 5 — Khu B"
  plannedStart DateTime
  plannedEnd   DateTime
  actualStart  DateTime?
  actualEnd    DateTime?
  pctComplete  Float             @default(0) // 0..100
  state        ScheduleTaskState @default(PLANNED)
  isCritical   Boolean           @default(false) // on critical path
  ownerOrgId   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessors ScheduleDependency[] @relation("SuccessorTask")
  successors   ScheduleDependency[] @relation("PredecessorTask")

  @@unique([projectId, code])
  @@index([projectId, plannedStart])
  @@index([projectId, isCritical, state])
}

enum ScheduleTaskState {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  DONE
  CANCELLED
}

model ScheduleDependency {
  id            String                 @id @default(cuid())
  predecessorId String
  successorId   String
  kind          ScheduleDependencyKind @default(FS)
  lagDays       Int                    @default(0)

  predecessor ScheduleTask @relation("PredecessorTask", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   ScheduleTask @relation("SuccessorTask", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
}

enum ScheduleDependencyKind {
  FS // Finish-to-Start (mặc định)
  SS // Start-to-Start
  FF // Finish-to-Finish
  SF // Start-to-Finish
}

// ============================================================================
//  PERMITFLOW module — xin Giấy phép xây dựng (NĐ 15/2021)
// ============================================================================

model PermitApplication {
  id              String                 @id @default(cuid())
  projectId       String
  permitType      PermitType
  applicationCode String? // số hồ sơ Sở XD trả
  applicant       String // Tổ chức/cá nhân nộp đơn
  submittedAt     DateTime?
  receivedAt      DateTime? // Sở XD tiếp nhận
  decisionAt      DateTime?
  decision        PermitDecision         @default(PENDING)
  decisionNote    String?                @db.Text
  expiresAt       DateTime?
  evidenceUrl     String? // URL tới quyết định cấp GPXD
  state           PermitApplicationState @default(DRAFT)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklist PermitChecklist[]

  @@index([projectId, state])
  @@index([state, decisionAt])
}

enum PermitType {
  GPXD_MOI // Giấy phép xây dựng mới
  GPXD_DIEU_CHINH // Điều chỉnh
  GPXD_SUA_CHUA // Sửa chữa, cải tạo
  GPXD_TAM // Tạm
  THONG_BAO_KHOI_CONG // Thông báo khởi công
  GPXD_HA_TANG // Hạ tầng (Sở GTVT/Bộ XD)
}

enum PermitApplicationState {
  DRAFT
  SUBMITTED
  REVIEWING // Sở XD đang thẩm tra
  APPROVED
  REJECTED
  WITHDRAWN
}

enum PermitDecision {
  PENDING
  APPROVED
  REJECTED
}

// Each checklist row maps to NĐ 15/2021 Phụ lục I item.
model PermitChecklist {
  id            String   @id @default(cuid())
  applicationId String
  itemCode      String // "PL-I.A.1" — anchor to NĐ 15/2021 Phụ lục
  itemTitle     String
  required      Boolean  @default(true)
  attached      Boolean  @default(false)
  evidenceUrl   String?
  note          String?
  updatedAt     DateTime @updatedAt

  application PermitApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, itemCode])
}

// ============================================================================
//  PCCC module — Hồ sơ thẩm duyệt PCCC (NĐ 136/2020 + TCVN 5738)
// ============================================================================

model PcccApplication {
  id              String               @id @default(cuid())
  projectId       String
  stage           PcccStage
  applicationCode String?
  submittedAt     DateTime?
  decisionAt      DateTime?
  decision        PermitDecision       @default(PENDING)
  decisionNote    String?              @db.Text
  evidenceUrl     String?
  state           PcccApplicationState @default(DRAFT)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, state])
}

enum PcccStage {
  THAM_DUYET_THIET_KE // Thẩm duyệt thiết kế PCCC
  NGHIEM_THU_PCCC // Nghiệm thu PCCC (trước đưa vào sử dụng)
  CAP_GIAY_DU_DIEU_KIEN // Giấy chứng nhận đủ điều kiện
}

enum PcccApplicationState {
  DRAFT
  SUBMITTED
  REVIEWING // Cảnh sát PCCC đang thẩm tra
  APPROVED
  REJECTED
  WITHDRAWN
}
