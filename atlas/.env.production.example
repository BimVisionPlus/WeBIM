# ────────────────────────────────────────────────────────────────────────────
# Atlas AEC — production environment template
#
# COPY this to your secret store (Vault / Doppler / 1Password / Render env)
# DO NOT commit a populated copy. .env / .env.local are gitignored.
#
# All values here are REQUIRED for a safe prod boot. Use:
#   openssl rand -base64 32   → AUTH_SECRET, S3_SECRET_KEY, WINWORK_SCRAPE_SECRET
#   openssl rand -hex 16      → POSTGRES_PASSWORD, REDIS_PASSWORD
# ────────────────────────────────────────────────────────────────────────────

# ─── Database (Neon free tier — pooler URL required for Vercel serverless) ──
# https://console.neon.tech/ → Project → Connection Details → Pooled connection
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/atlas_aec?sslmode=require"

# ─── NextAuth ───────────────────────────────────────────────────────────────
AUTH_SECRET="<openssl rand -base64 32>"     # MUST be ≥ 32 chars
AUTH_URL="https://app.aecplatform.vn"
NEXT_PUBLIC_BASE_URL="https://app.aecplatform.vn"
AUTH_TRUST_HOST="true"

# ─── S3 — self-hosted MinIO on the same VPS (default for this build) ────────
# docker-compose.prod.yml runs MinIO + minio-init (auto-creates 4 buckets).
# To swap to Cloudflare R2 later: replace S3_ENDPOINT + keys, leave bucket names,
# and remove the `minio` + `minio-init` services from docker-compose.prod.yml.
MINIO_ROOT_USER="atlas"
MINIO_ROOT_PASSWORD="<openssl rand -base64 24>"
S3_ENDPOINT="http://minio:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="atlas"
S3_SECRET_KEY="<must equal MINIO_ROOT_PASSWORD above>"
S3_BUCKET_MODELS="atlas-models"
S3_BUCKET_DRAWINGS="atlas-drawings"
S3_BUCKET_MARKUPS="atlas-markups"
S3_BUCKET_ATTACHMENTS="atlas-attachments"
S3_FORCE_PATH_STYLE="true"

# ─── Redis (Upstash free tier — 10k commands/day) ──────────────────────────
# https://console.upstash.com/ → Create regional database in Singapore
REDIS_URL="rediss://default:<password>@<endpoint>:6379"

# ─── Autodesk Forge / APS ──────────────────────────────────────────────────
# Register a free 2-legged app: https://aps.autodesk.com
# Without these, BIM uploads succeed but APS translation status stays PENDING.
APS_CLIENT_ID=""
APS_CLIENT_SECRET=""
APS_BUCKET_KEY="atlas-aec-prod-models"

# ─── Email (transactional) ──────────────────────────────────────────────────
# Pick Resend (recommended), Postmark, or any SMTP provider.
# Without these: password reset / invite / NPS surveys silently no-op.
EMAIL_FROM="Atlas AEC <no-reply@aecplatform.vn>"
AUTH_EMAIL_FROM="Atlas AEC <no-reply@aecplatform.vn>"
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS="<RESEND_API_KEY>"
RESEND_API_KEY="<RESEND_API_KEY>"

# ─── Billing / chuyển khoản (Bước 4) ────────────────────────────────────────
# Hiển thị trong /settings/billing + email reply khi khách yêu cầu nâng cấp.
# Khi tiền vào: ORG=<slug> PLAN=<pro|business> tsx scripts/activate-subscription.ts
BANK_NAME="TPBank"
BANK_ACCOUNT="0925629416"
BANK_HOLDER="NGUYEN THU THUY"
BILLING_INBOX="billing@aecplatform.vn"

# ─── AI (OSS, self-host) ────────────────────────────────────────────────────
# Default: docker-compose --profile ai brings these up locally.
# Production: deploy Ollama on a GPU instance and point at it.
AI_ENABLED="true"
OLLAMA_URL="http://ollama.internal:11434"
OLLAMA_MODEL_LLM="qwen2.5:7b-instruct"
OLLAMA_MODEL_VLM="qwen2.5-vl:7b"
OLLAMA_MODEL_EMBED="bge-m3"
WHISPER_URL="http://whisper.internal:9000"

# ─── WinWork scraper trigger ────────────────────────────────────────────────
# Allows the cron worker to POST /api/winwork/tenders/scrape without admin auth.
WINWORK_SCRAPE_SECRET="<openssl rand -base64 32>"

# ─── Observability (optional but recommended) ───────────────────────────────
SENTRY_DSN=""                              # leave blank to disable
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE="0.1"

# ─── Subscription / billing (Layer 8) ───────────────────────────────────────
# Manual bank-transfer flow works without any of these. Wire one to unlock
# self-serve upgrade from /pricing.
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
