# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://atlas:atlas@localhost:5436/atlas_aec?schema=public"

# ─── S3 / MinIO ──────────────────────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9020"
S3_REGION="us-east-1"
S3_ACCESS_KEY="atlas"
S3_SECRET_KEY="atlas-secret-key"
S3_BUCKET_MODELS="models"
S3_BUCKET_DRAWINGS="drawings"
S3_BUCKET_MARKUPS="markups"
S3_BUCKET_ATTACHMENTS="attachments"
S3_FORCE_PATH_STYLE="true"

# ─── Autodesk Forge / APS (BIM model viewer) ─────────────────────────────────
# Register an app at https://aps.autodesk.com/ to get these.
# Leave blank to skip APS translation — model uploads still work, viewer stays PENDING.
APS_CLIENT_ID=""
APS_CLIENT_SECRET=""
APS_BUCKET_KEY="atlas-aec-models"
APS_CALLBACK_URL="http://localhost:3000/api/aps/callback"

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED: at least 32 chars. Generate: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ─── Email (transactional: invites + password reset + waitlist confirm) ──────
# Either RESEND_API_KEY or AUTH_EMAIL_SERVER. Without either, emails are logged
# to stdout in dev so you can copy magic links from terminal.
RESEND_API_KEY=""
AUTH_EMAIL_SERVER=""                  # smtp://user:pass@host:587
AUTH_EMAIL_FROM=""                    # also enables NextAuth Email provider
EMAIL_FROM="Atlas AEC <no-reply@atlas-aec.vn>"

# ─── VN chữ ký số (digital signature for BBNT — pilot: not yet wired) ────────
VNPT_CA_API=""
VIETTEL_CA_API=""

# ─── VN HĐĐT (e-invoice per NĐ 123/2020 — pilot: not yet wired) ──────────────
EINVOICE_PROVIDER="viettel"          # viettel | vnpt | misa | bkav
EINVOICE_API_KEY=""
EINVOICE_MST=""                       # Mã số thuế of issuing org

# ─── Redis (rate-limit + queue) ──────────────────────────────────────────────
# Optional in dev (memory fallback). Required in prod for distributed rate-limit.
REDIS_URL="redis://localhost:6380"

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=""
LOG_LEVEL="info"                      # trace | debug | info | warn | error | fatal

# ─── AI stack (OSS-only — Ollama + faster-whisper) ───────────────────────────
# Boot with: pnpm ai:up   (first run pulls ~10GB of model weights)
# Set AI_ENABLED=false to disable AI calls entirely; suggestions return null.
AI_ENABLED="true"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_LLM_MODEL="qwen2.5:7b-instruct"   # text — VN-strong: qwen2.5, llama3.1, deepseek-r1
OLLAMA_VLM_MODEL="qwen2.5vl:7b"          # vision — for NCR photo + drawing OCR
OLLAMA_EMBED_MODEL="bge-m3"              # embeddings — multilingual, VN-friendly
OLLAMA_TIMEOUT_MS="45000"
WHISPER_BASE_URL="http://localhost:8009"
WHISPER_MODEL="Systran/faster-whisper-medium"
WHISPER_TIMEOUT_MS="60000"

# ─── Public ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Atlas AEC"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_INDEXABLE="false"         # set "true" once content is final
